# =========================================================
# Variáveis de ambiente · 45 Anos Nossa Lavoura
# Copie para `.env` e preencha. O `.env` não é versionado.
# Validadas por Zod em `lib/env.ts`: faltando qualquer uma das
# obrigatórias, o servidor não sobe.
# =========================================================

# --- Banco Neon (obrigatória) -----------------------------
# Connection string com pooling. O painel do Neon já entrega
# esta e as demais (PG*, POSTGRES_*) prontas para colar.
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/banco?sslmode=require

# --- Aplicação ---------------------------------------------
# Origem pública desta instalação. É a base do link do convite:
# {APP_BASE_URL}/palestras/c/{codigo}
#
# Obrigatória no ambiente local e em PRODUÇÃO na Vercel, onde
# precisa ser o domínio da campanha — o link vai para o WhatsApp
# de produtores e não pode apontar para uma URL de deploy.
#
# Em PREVIEW pode ser omitida: o carregador usa a origem que a
# própria Vercel expõe (VERCEL_BRANCH_URL, com VERCEL_URL como
# reserva), e assim cada branch funciona sem variável própria.
#
# Local:      http://localhost:3000
# Produção:   https://45anosnossalavoura.agpremium.com.br
APP_BASE_URL=http://localhost:3000

# --- Rotina de expiração (obrigatória) --------------------
# Segredo exigido pela rota /api/cron/expirar-convites.
# Na Vercel, o Cron envia automaticamente em
# `Authorization: Bearer $CRON_SECRET`.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# --- Autenticação · Better Auth (obrigatórias) ------------
# Assina os cookies de sessão e os tokens de verificação.
# Trocar o segredo derruba todas as sessões e invalida os
# links mágicos em trânsito — o que é o desejado num vazamento.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Origem confiável do Better Auth (verificação contra CSRF e
# base dos links de acesso). Em geral igual a APP_BASE_URL;
# se não for definida, APP_BASE_URL é usada como padrão — o que
# na Vercel basta, inclusive em preview.
BETTER_AUTH_URL=http://localhost:3000

# --- E-mail transacional · Resend -------------------------
# Chave da API do Resend. OPCIONAL de propósito: sem ela o
# envio falha com mensagem neutra e registro no log, e o
# sistema continua de pé (senha e CPF + nascimento seguem
# funcionando). O valor abaixo é um placeholder e é tratado
# como ausente por `lib/env.ts`.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remetente dos e-mails. Precisa ser do domínio
# agpremium.com.br — é onde SPF, DKIM e DMARC estão
# configurados. Outro domínio entrega direto no spam.
EMAIL_FROM=Acelera no Campo <palestras@agpremium.com.br>
